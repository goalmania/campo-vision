# Copy this file to .env (local) and set the same keys in Vercel → Project → Settings → Environment Variables.
# Get a free access key at https://web3forms.com — enter your email, no account/password needed.
# Without this key, the "Richiedi una demo" forms show a friendly WhatsApp fallback instead of failing silently.
VITE_WEB3FORMS_ACCESS_KEY=

# Brevo API key (Settings → SMTP & API → API Keys in app.brevo.com). Server-side
# only — do NOT prefix with VITE_, it must never reach the client bundle.
# Used by api/brevo-lead.ts to add demo-request leads to the nurture-email
# automation's list. Safe to leave unset: the form still works via Web3Forms,
# it just won't sync the lead into Brevo.
BREVO_API_KEY=
