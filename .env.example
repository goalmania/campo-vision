# Copy this file to .env (local) and set the same key in Vercel → Project → Settings → Environment Variables.
# Get a free access key at https://web3forms.com — enter your email, no account/password needed.
# Without this key, the "Richiedi una demo" forms show a friendly WhatsApp fallback instead of failing silently.
VITE_WEB3FORMS_ACCESS_KEY=
